---
import BaseLayout from './BaseLayout.astro';
import ArticleSchema from '../components/ArticleSchema.astro';

interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  canonicalUrl?: string;
  breadcrumbItems?: BreadcrumbItem[];
  section?: string;
}

const {
  title,
  description,
  image,
  publishedTime,
  modifiedTime,
  canonicalUrl,
  breadcrumbItems,
  section,
} = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  image={image}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  canonicalUrl={canonicalUrl}
  type="article"
  active="categories"
  progress={true}
>
  <ArticleSchema
    slot="schema"
    title={title}
    description={description}
    image={image}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    canonicalUrl={canonicalUrl}
    breadcrumbItems={breadcrumbItems}
    section={section}
  />
  <slot />
</BaseLayout>
