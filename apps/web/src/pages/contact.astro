---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontak"
  description="Hubungi SEMBURAT untuk pertanyaan, kerja sama editorial, atau laporan kesalahan."
>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6 lg:px-8">
    <nav class="mb-6 text-sm text-text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent-hover">Beranda</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">Kontak</span>
    </nav>
    <h1 class="mb-6 text-3xl font-bold leading-tight text-primary sm:text-4xl">Kontak</h1>

    <div class="space-y-6 text-base leading-relaxed text-text">
      <p>
        Gunakan formulir di bawah ini atau email untuk menghubungi tim SEMBURAT. Kami akan merespon sesegera mungkin.
      </p>

      <form class="space-y-4" method="POST" action="/api/contact">
        <div>
          <label for="name" class="block text-sm font-medium text-text">Nama</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="mt-1 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-text focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-text">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-text focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-text">Pesan</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-text focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          ></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-hover"
        >
          Kirim Pesan
        </button>
      </form>

      <p class="text-sm text-text-muted">
        Untuk keperluan editorial, koreksi, atau kerja sama, kirim email ke
        <a href="mailto:editorial@semburat.example.id" class="text-accent-hover hover:underline">
          editorial@semburat.example.id
        </a>.
      </p>
    </div>
  </section>
</BaseLayout>