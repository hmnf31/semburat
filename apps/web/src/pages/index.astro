---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleArt from '../components/ArticleArt.astro';
import StoryCard from '../components/StoryCard.astro';
import { getArticles, getCategoryCounts, toCard, formatDate } from '../lib/content';
import { categoryHref, categoryKey, resolveVisual } from '../lib/visuals';
import { categories } from '../data/categories';

function wordsPerMinute(text: string): number {
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
}

const articles = await getArticles();
const cards = articles.map(toCard);

const lead = articles[0];
const side = articles.slice(1, 5);
const grid = cards.slice(5, 10);

const leadVisual = lead ? resolveVisual(lead.slug, lead.category) : undefined;
const leadImage = lead?.assets.find((asset) => asset.type === 'image');
const leadCaption =
  leadVisual?.kind === 'source'
    ? `Sumber gambar: ${leadImage?.title ?? 'Wikimedia Commons'}`
    : 'Ilustrasi oleh SEMBURAT.';

const ranked = (await getCategoryCounts()).map((topic, index) => ({
  ...topic,
  rank: index + 1,
  slug: categoryKey(topic.label),
}));
---

<BaseLayout
  title="SEMBURAT — Yang sedang muncul, kami rangkai menjadi cerita"
  description="SEMBURAT merangkum tren, sumber, dan konteks menjadi artikel editorial yang terverifikasi dan transparan."
  bigMast={true}
>
  {
    lead && (
      <article class="cover">
        <h1>
          <a href={`/articles/${lead.slug}/`}>{lead.title}</a>
        </h1>
        <div class="cover-grid">
          <div class="col-text">
            <p class="kicker">{lead.category}</p>
            <p class="deck">{lead.dek}</p>
            <p class="small" style="margin:0 0 20px">
              {formatDate(lead.publishedAt)}, {wordsPerMinute(lead.body)} menit baca
            </p>
            <a class="readmore" href={`/articles/${lead.slug}/`}>
              Baca selengkapnya
            </a>
          </div>
          <div class="col-art">
            <ArticleArt slug={lead.slug} category={lead.category} title={lead.title} />
            <div class="fig">
              <b>Gambar 1.</b>
              <span>{leadCaption}</span>
            </div>
          </div>
          <aside class="aside" aria-label="Juga di edisi ini">
            <h2>Juga di edisi ini</h2>
            <ol>
              {side.map((article) => (
                <li>
                  <a href={`/articles/${article.slug}/`}>{article.title}</a>
                  <span>
                    <span class={`chip ${categoryKey(article.category)}`}>{article.category}</span>
                  </span>
                </li>
              ))}
            </ol>
          </aside>
        </div>
      </article>
    )
  }

  <section aria-labelledby="lain">
    <div class="sec">
      <h2 id="lain">Artikel lainnya</h2>
      <a class="readmore" href="/categories/">Lihat semua kategori</a>
    </div>
    <div class="stories">
      {grid[0] && <StoryCard {...grid[0]} variant="s-a" />}
      {grid[1] && <StoryCard {...grid[1]} variant="s-b" />}
      {grid[2] && <StoryCard {...grid[2]} variant="s-c" />}
      {grid[3] && <StoryCard {...grid[3]} variant="s-c" />}
      {grid[4] && <StoryCard {...grid[4]} variant="s-c" />}
    </div>
  </section>

  <section class="toc" aria-labelledby="topik">
    <div class="sec">
      <h2 id="topik">Topik trending</h2>
      <a class="readmore" href="/trending/">Lihat trending</a>
    </div>
    <ol>
      {
        ranked.map((topic) => (
          <li>
            <a class="row" href={categoryHref(topic.label)}>
              <span class="n">{topic.rank}</span>
              <span class="t">{categories[topic.slug]?.name ?? topic.label}</span>
              <span class="d" />
              <span class="c">{topic.count} artikel</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
