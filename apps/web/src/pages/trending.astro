---
import BaseLayout from '../layouts/BaseLayout.astro';
import { softLaunchArticles } from '../data/soft-launch-articles';

const trendingTopics = softLaunchArticles
  .filter((a) => a.status === 'published')
  .reduce((acc, article) => {
    const key = article.category;
    acc[key] = (acc[key] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);

const trendingTopicsArray = Object.entries(trendingTopics)
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count)
  .map((topic, index) => ({ ...topic, rank: index + 1, href: '/categories/' + topic.label.toLowerCase() }));
---

<BaseLayout title="Trending" description="Topik yang sedang tren di SEMBURAT — data dari 10 artikel soft launch.">
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <h1 class="mb-2 text-3xl font-bold text-primary">Trending</h1>
    <p class="mb-8 text-sm text-text-muted">
      Daftar placeholder. Peringkat sesungguhnya dihitung dari sumber terverifikasi dengan penjelasan yang dapat dilacak.
    </p>
    <ol class="space-y-4">
      {trendingTopicsArray.map((topic) => (
        <li class="flex items-center gap-4 rounded-lg border border-border bg-surface p-4">
          <span class="w-10 shrink-0 text-center text-2xl font-bold text-accent" aria-label={`Peringkat ${topic.rank}`}>
            {topic.rank}
          </span>
          <div class="flex-1">
            <a href={topic.href} class="font-semibold text-primary hover:underline">
              {topic.label}
            </a>
            <p class="mt-0.5 text-sm text-text-muted">{topic.count} artikel</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>