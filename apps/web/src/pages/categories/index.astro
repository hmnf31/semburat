---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../lib/content';
import { CATEGORY_KEYS, categoryKey } from '../../lib/visuals';
import { categories } from '../../data/categories';

const articles = await getArticles();

const blocks = CATEGORY_KEYS.map((slug) => ({
  slug,
  name: categories[slug]?.name ?? slug,
  description: categories[slug]?.description ?? '',
  articles: articles.filter((article) => categoryKey(article.category) === slug),
}));
---

<BaseLayout
  title="Kategori"
  description="Semua kategori artikel SEMBURAT: viral, teknologi, gaming, dan explainer."
  active="categories"
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Kategori</span>
  </nav>
  <div class="phead">
    <p class="kicker">Semua topik</p>
    <h1>Kategori</h1>
    <p>Pilih topik untuk membaca artikel yang sudah terbit.</p>
  </div>
  <section class="catlist">
    {
      blocks.map((block) => (
        <article class="catblock">
          <h2>
            <a href={`/categories/${block.slug}/`}>{block.name}</a>
          </h2>
          <div>
            <p>{block.description}</p>
            <p class="small">{block.articles.length} artikel terbit</p>
            <a class="readmore" href={`/categories/${block.slug}/`}>
              Buka kategori
            </a>
          </div>
          <ul>
            {block.articles.map((article) => (
              <li>
                <a href={`/articles/${article.slug}/`}>{article.title}</a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</BaseLayout>
