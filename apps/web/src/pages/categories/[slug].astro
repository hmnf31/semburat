---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { categories } from '../../data/categories';
import { getArticles, toCard } from '../../lib/content';

export function getStaticPaths() {
  return Object.entries(categories).map(([slug, category]) => ({
    params: { slug },
    props: { categoryName: category.name },
  }));
}

const { categoryName } = Astro.props;
const categoryKeyLower = categoryName.toLowerCase();
const description = categories[categoryKeyLower]?.description ?? '';

const cards = (await getArticles())
  .filter((article) => article.category.toLowerCase() === categoryKeyLower)
  .map(toCard);

const variants = cards.length === 2 ? (['s-a', 's-b'] as const) : null;
---

<BaseLayout
  title={`Kategori ${categoryName}`}
  description={`Artikel kategori ${categoryName} di SEMBURAT. ${description}`}
  active="categories"
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span aria-hidden="true">/</span>
    <a href="/categories/">Kategori</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{categoryName}</span>
  </nav>
  <div class="phead">
    <p class="kicker">Kategori</p>
    <h1>{categoryName}</h1>
    <p>{description} {cards.length} artikel terbit dalam kategori ini.</p>
  </div>
  {
    cards.length > 0 ? (
      <div class="stories">
        {cards.map((card, index) => (
          <StoryCard {...card} variant={variants ? variants[index] ?? 's-c' : 's-c'} />
        ))}
      </div>
    ) : (
      <p class="small">Belum ada artikel terbit di kategori ini.</p>
    )
  }
</BaseLayout>
