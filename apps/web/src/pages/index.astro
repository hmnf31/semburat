---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { softLaunchArticles } from '../data/soft-launch-articles';

function computeReadTime(body: string): string {
  const wordCount = body.split(/\\s+/).length;
  return String(Math.max(1, Math.ceil(wordCount / 200)));
}

const latestArticles = softLaunchArticles
  .filter((a) => a.status === 'published')
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 6)
  .map((article) => ({
    title: article.title,
    dek: article.dek,
    category: article.category,
    categoryHref: '/categories/' + article.category.toLowerCase(),
    date: article.publishedAt,
    readTime: computeReadTime(article.body),
    slug: article.slug,
  }));

const trendingTopics = softLaunchArticles
  .filter((a) => a.status === 'published')
  .reduce((acc, article) => {
    const key = article.category;
    acc[key] = (acc[key] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);

const trendingTopicsArray = Object.entries(trendingTopics)
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);
---

<BaseLayout title="Beranda" description="SEMBURAT — platform media intelligence Indonesia. Yang sedang muncul, kami rangkai menjadi cerita.">
  <section class="bg-sb-primary px-4 py-16 text-center sm:py-20">
    <p class="mb-3 font-label text-sm font-semibold uppercase tracking-widest text-sb-surface-cream">Media Intelligence Indonesia</p>
    <h1 class="mx-auto max-w-2xl font-heading text-3xl font-normal leading-tight text-white sm:text-4xl lg:text-5xl">
      Yang sedang muncul, kami rangkai menjadi cerita.
    </h1>
    <p class="mx-auto mt-4 max-w-xl font-body text-base text-sb-surface-cream">
      SEMBURAT merangkum tren, sumber, dan konteks menjadi artikel editorial yang terverifikasi dan transparan.
    </p>
  </section>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-heading text-2xl font-normal text-sb-ink">Artikel Terbaru</h2>
        <p class="mt-1 text-sm text-sb-muted">10 artikel contoh untuk soft launch.</p>
      </div>
      <a href="/trending" class="font-body text-sm font-medium text-sb-primary hover:text-sb-primary-surface">
        Lihat trending →
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestArticles.map((article) => (
        <ArticleCard {...article} />
      ))}
    </div>
  </section>
  <section class="border-t border-sb-hairline bg-sb-surface">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="mb-6 font-heading text-2xl font-normal text-sb-ink">Topik Trending</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {trendingTopicsArray.map((topic, index) => (
          <li class="rounded-lg border border-sb-hairline bg-sb-card p-4">
            <span class="mb-2 block font-heading text-2xl font-normal text-sb-primary">{index + 1}</span>
            <a href="/trending" class="font-body font-medium text-sb-ink hover:text-sb-primary">
              {topic.label}
            </a>
            <p class="mt-1 font-body text-xs text-sb-muted">{topic.count} artikel</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>