---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories } from '../../data/categories';
import { getArticles, toCard } from '../../lib/content';

export function getStaticPaths() {
  return Object.entries(categories).map(([slug, category]) => ({
    params: { slug },
    props: { categoryName: category.name },
  }));
}

const { categoryName } = Astro.props;
const articles = (await getArticles())
  .filter((article) => article.category.toLowerCase() === categoryName.toLowerCase())
  .map(toCard);
---

<BaseLayout
  title={`Kategori ${categoryName}`}
  description={`Artikel kategori ${categoryName} di SEMBURAT.`}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p class="mb-3 font-label text-xs font-semibold uppercase tracking-widest text-sb-primary">Kategori</p>
    <h1 class="mb-2 font-heading text-3xl font-normal text-sb-ink">{categoryName}</h1>
    <p class="mb-8 font-body text-sm text-sb-muted">
      {articles.length} artikel terbit dalam kategori ini.
    </p>
    {articles.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard {...article} />
        ))}
      </div>
    ) : (
      <p class="rounded-lg border border-sb-hairline bg-sb-card p-6 font-body text-sm text-sb-muted">
        Belum ada artikel terbit di kategori ini.
      </p>
    )}
  </section>
</BaseLayout>