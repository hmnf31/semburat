---
interface Props {
  creator: string;
  license: string;
  credit: string;
  sourceUrl?: string;
}

const { creator, license, credit, sourceUrl } = Astro.props;
---
<section aria-labelledby="kredit-visual-heading" class="mt-6 rounded-lg border border-sb-hairline bg-sb-card p-5">
  <h2 id="kredit-visual-heading" class="mb-3 font-heading text-lg font-normal text-sb-ink">
    Kredit Visual
  </h2>
  <dl class="font-body space-y-2 text-sm text-sb-ink">
    <div class="flex flex-wrap gap-x-2">
      <dt class="font-body font-medium text-sb-tertiary">Kreator:</dt>
      <dd>{creator}</dd>
    </div>
    <div class="flex flex-wrap gap-x-2">
      <dt class="font-body font-medium text-sb-tertiary">Lisensi:</dt>
      <dd>{license}</dd>
    </div>
    <div class="flex flex-wrap gap-x-2">
      <dt class="font-body font-medium text-sb-tertiary">Kredit:</dt>
      <dd>
        {sourceUrl ? (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-sb-primary hover:text-sb-primary-surface hover:underline">
            {credit}
          </a>
        ) : (
          credit
        )}
      </dd>
    </div>
  </dl>
</section>
