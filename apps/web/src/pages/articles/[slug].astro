---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleArt from '../../components/ArticleArt.astro';
import StoryCard from '../../components/StoryCard.astro';
import { resolveVisual, categoryHref, categoryKey } from '../../lib/visuals';
import type { ContentArticle } from '../../lib/content';
import { getArticles, getRelated, riskLabel } from '../../lib/content';
import { SITE_URL } from '../../lib/site';

function wordsPerMinute(text: string): number {
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
}

function formatWib(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return iso;
  const parts = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Jakarta',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).formatToParts(date);
  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
  return `${get('day')} ${get('month')} ${get('year')}, ${get('hour')}:${get('minute')} WIB`;
}

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: ContentArticle };
const readTime = wordsPerMinute(article.body);
const chip = categoryKey(article.category);
const canonicalUrl = `${SITE_URL}/articles/${article.slug}`;
const ogImage = `/og/${article.slug}-og-hero.png`;
const publishedWib = formatWib(article.publishedAt);

const paragraphs = article.body
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);

const visual = resolveVisual(article.slug, article.category);
const imageAsset = article.assets.find((asset) => asset.type === 'image');
const usesSourceImage = visual.kind === 'source' && Boolean(imageAsset?.sourceUrl);
const caption = usesSourceImage
  ? `Sumber gambar: ${imageAsset?.title ?? 'Wikimedia Commons'}`
  : 'Ilustrasi oleh SEMBURAT.';

const related = await getRelated(article.slug);

const all = await getArticles();
const index = all.findIndex((entry) => entry.slug === article.slug);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index + 1 < all.length ? all[index + 1] : undefined;

const breadcrumbItems = [
  { name: 'Beranda', href: '/' },
  { name: article.category, href: categoryHref(article.category) },
  { name: article.title },
];
---

<ArticleLayout
  title={article.title}
  description={article.dek}
  image={ogImage}
  publishedTime={article.publishedAt}
  modifiedTime={article.updatedAt ?? article.publishedAt}
  canonicalUrl={canonicalUrl}
  breadcrumbItems={breadcrumbItems}
  section={article.category}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span aria-hidden="true">/</span>
    <a href={categoryHref(article.category)}>{article.category}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Artikel</span>
  </nav>

  <article>
    <header class="ahead">
      <span class={`chip ${chip}`}>{article.category}</span>
      <h1>{article.title}</h1>
      <p class="deck">{article.dek}</p>
      <div class="badges">
        <time datetime={article.publishedAt}>{publishedWib}</time>
        <span>{readTime} menit baca</span>
        <span class="badge">Risiko: {riskLabel(article.riskLevel)}</span>
        <span class="badge q">Kualitas {article.qualityScore}/100</span>
      </div>
    </header>

    <ArticleArt slug={article.slug} category={article.category} title={article.title} variant="hero" />
    <div class="fig">
      <b>Gambar 1.</b>
      <span>{caption}</span>
    </div>

    <div class="alayout">
      <aside class="pts" aria-label="Poin penting">
        <h2>Poin penting</h2>
        <ul>
          {article.keyPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>

      <div class="prose">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

        {
          article.faq.length > 0 && (
            <div class="faq-wrap">
              <h2>Pertanyaan umum</h2>
              {article.faq.map((item) => (
                <details class="faq">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          )
        }

        {
          article.sources.length > 0 && (
            <>
              <h2>Sumber</h2>
              <ol class="refs">
                {article.sources.map((source) => (
                  <li>
                    <a href={source.url} target="_blank" rel="noopener noreferrer">
                      {source.title}
                    </a>
                  </li>
                ))}
              </ol>
            </>
          )
        }

        <h2>Kredit visual</h2>
        <div class="credit">
          <dl>
            <dt>Kreator</dt>
            <dd>{usesSourceImage ? (imageAsset?.credit ?? 'Sumber tidak diketahui') : 'SEMBURAT'}</dd>
            <dt>Lisensi</dt>
            <dd>
              {usesSourceImage
                ? (imageAsset?.license ?? 'Lisensi tidak diketahui')
                : 'Karya visual asli SEMBURAT, bukan foto pihak ketiga'}
            </dd>
            <dt>Kredit</dt>
            <dd>
              {usesSourceImage && imageAsset?.sourceUrl ? (
                <a href={imageAsset.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {caption}
                </a>
              ) : (
                'Ilustrasi oleh SEMBURAT'
              )}
            </dd>
          </dl>
        </div>
      </div>

      <div class="spacer" />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="terkait">
        <div class="sec">
          <h2 id="terkait">Artikel terkait</h2>
        </div>
        <div class="stories" style="padding-bottom:0">
          {related.map((card) => (
            <StoryCard {...card} variant="s-d" />
          ))}
        </div>
      </section>
    )
  }

  <nav class="pager" aria-label="Artikel lain">
    {
      newer ? (
        <a href={`/articles/${newer.slug}/`}>
          <div class="lab">Lebih baru</div>
          <div class="tt">{newer.title}</div>
        </a>
      ) : (
        <span />
      )
    }
    {
      older ? (
        <a href={`/articles/${older.slug}/`}>
          <div class="lab">Lebih lama</div>
          <div class="tt">{older.title}</div>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</ArticleLayout>
