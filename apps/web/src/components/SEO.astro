---
import { DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_TYPE, SITE_DESCRIPTION, SITE_NAME, SITE_URL, absoluteUrl } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'SEMBURAT adalah platform media intelligence Indonesia yang merangkum tren dan sumber menjadi artikel editorial terverifikasi.',
  image = DEFAULT_OG_IMAGE,
  publishedTime,
  modifiedTime,
  canonicalUrl,
  type = 'website',
} = Astro.props;

const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const canonical = canonicalUrl ? absoluteUrl(canonicalUrl) : SITE_URL;
const absoluteImage = absoluteUrl(image);

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      inLanguage: 'id-ID',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/favicon.svg`,
      },
    },
  ],
};

const siteJsonLd = JSON.stringify(siteSchema);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_NAME} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
{image === DEFAULT_OG_IMAGE && <meta property="og:image:type" content={DEFAULT_OG_IMAGE_TYPE} />}
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="id_ID" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<script type="application/ld+json" set:html={siteJsonLd} />

<slot />