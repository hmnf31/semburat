# SALIN ke .env (lokal) dan JANGAN commit .env. Di produksi pakai GitHub Actions Secrets / Cloudflare secrets.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=         # daftar ID Telegram yang boleh memakai bot, pisahkan koma
CLOUDFLARE_API_TOKEN=              # izin minimal: Pages, Workers, D1, R2 untuk akun ini saja
CLOUDFLARE_ACCOUNT_ID=
MINIMAX_API_KEY=                   # opsional, hanya jika voice over dipakai (berbayar)
SOCIAL_API_KEYS=                   # kosong sampai izin platform tersedia

# Perilaku sistem
SEMBURAT_DRY_RUN=true              # true = tidak publish apa pun
SEMBURAT_AUTO_PUBLISH=false        # tetap false selama soft launch
SEMBURAT_KILL_SWITCH=false         # true = hentikan semua job terjadwal
SITE_URL=https://GANTI-DENGAN-DOMAIN-ANDA
