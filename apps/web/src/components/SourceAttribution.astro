---
interface Source {
  title: string;
  url: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---
{
  sources.length > 0 && (
    <section aria-labelledby="sumber-heading" class="mt-10 rounded-lg border border-sb-hairline bg-sb-card p-5">
      <h2 id="sumber-heading" class="mb-3 font-heading text-lg font-normal text-sb-ink">
        Sumber
      </h2>
      <ul class="font-body list-inside list-disc space-y-2 text-sm leading-relaxed text-sb-ink">
        {sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-sb-primary hover:text-sb-primary-surface hover:underline">
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
