{
  "name": "semburat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "placeholder-database-id",
      "database_name": "semburat-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "semburat-assets",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
  },
}
