{
  "name": "semburat-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:py": "python -m unittest discover -s tests",
    "typecheck": "turbo run typecheck",
    "articles:export": "tsx tools/export_articles.ts --out social-out/articles.json",
    "social:pack": "tsx tools/export_articles.ts --out social-out/articles.json && python tools/social_pack.py --articles social-out/articles.json --out social-out/packs --assets-dir apps/web/src/assets/articles",
    "social:send": "python tools/telegram_send.py --packs social-out/packs",
    "social:review": "pnpm social:pack && pnpm social:send",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "vitest": "^1.3.0",
    "@vitest/coverage-v8": "^1.3.0",
    "tsx": "^4.7.0",
    "rimraf": "^5.0.0",
    "cross-env": "^7.0.0",
    "dotenv": "^16.4.0",
    "zod": "^3.22.0",
    "@types/node": "^20.11.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-import": "^2.29.0"
  },
  "packageManager": "pnpm@9.12.0"
}
