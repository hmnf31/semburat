---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getCategoryCounts } from '../lib/content';
import { categoryHref, categoryKey } from '../lib/visuals';
import { categories } from '../data/categories';

const articles = await getArticles();

const ranked = (await getCategoryCounts()).map((topic, index) => {
  const slug = categoryKey(topic.label);
  return {
    rank: index + 1,
    slug,
    name: categories[slug]?.name ?? topic.label,
    count: topic.count,
    articles: articles.filter((article) => categoryKey(article.category) === slug),
  };
});
---

<BaseLayout
  title="Trending"
  description="Topik yang sedang tren di SEMBURAT, dihitung dari artikel terbit."
  active="trending"
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Trending</span>
  </nav>
  <div class="phead">
    <p class="kicker">Peringkat topik</p>
    <h1>Trending</h1>
    <p>Peringkat dihitung dari jumlah artikel terbit per kategori. Setiap artikel dapat dilacak ke sumbernya.</p>
  </div>
  <section class="toc">
    <ol>
      {
        ranked.map((topic) => (
          <li>
            <a class="row" href={categoryHref(topic.name)}>
              <span class="n">{topic.rank}</span>
              <span class="t">{topic.name}</span>
              <span class="d" />
              <span class="c">{topic.count} artikel</span>
            </a>
            <ul class="sub">
              {topic.articles.map((article) => (
                <li>
                  <a href={`/articles/${article.slug}/`}>{article.title}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
