# SEMBURAT environment template# Never commit real secrets.## Classification:#   [PUBLIC]     Safe to expose to the browser / client bundles.#   [SERVER]     Must never leave the server environment.# Runtime# [PUBLIC] Node.js runtime environmentNODE_ENV=development# Cloudflare# [SERVER] Cloudflare account ID for Workers, D1, R2CLOUDFLARE_ACCOUNT_ID=# [SERVER] Cloudflare API token with scoped permissionsCLOUDFLARE_API_TOKEN=# [SERVER] UUID of the D1 databaseD1_DATABASE_ID=# [SERVER] Name of the R2 storage bucketR2_BUCKET=# AI# [SERVER] API key for OpenRouter (primary AI provider)OPENROUTER_API_KEY=# [SERVER] Default model identifier for OpenRouterOPENROUTER_DEFAULT_MODEL=# Optional local AI# [SERVER] Base URL for optional local Ollama instanceOLLAMA_BASE_URL=http://localhost:11434# [SERVER] Default local Ollama modelOLLAMA_DEFAULT_MODEL=# Telegram# [SERVER] Bot token from @BotFatherTELEGRAM_BOT_TOKEN=# [SERVER] Secret used to validate webhook requestsTELEGRAM_WEBHOOK_SECRET=# MiniMax# [SERVER] API key for MiniMax voice/SFX generationMINIMAX_API_KEY=# [SERVER] Default MiniMax model identifierMINIMAX_MODEL=# Google Sheets# [SERVER] Service-account credentials JSON (full secret)GOOGLE_SHEETS_CREDENTIALS_JSON=# [SERVER] ID of the operational spreadsheetGOOGLE_SHEETS_SPREADSHEET_ID=# Application# [SERVER] Base URL of the application backendAPP_BASE_URL=# [PUBLIC] Public website URL (may be exposed to clients)PUBLIC_SITE_URL=# Observability# [SERVER] Logging verbosity (debug, info, warn, error)LOG_LEVEL=info# Companion kit settingsTELEGRAM_ALLOWED_USER_IDS=         # daftar ID Telegram yang boleh memakai bot, pisahkan komaSOCIAL_API_KEYS=                   # kosong sampai izin platform tersediaSEMBURAT_DRY_RUN=true              # true = tidak publish apa punSEMBURAT_AUTO_PUBLISH=false        # tetap false selama soft launchSEMBURAT_KILL_SWITCH=false         # true = hentikan semua job terjadwalSITE_URL=https://GANTI-DENGAN-DOMAIN-ANDA