---
const year = new Date().getFullYear();

const footerLinks = [
  { roman: 'I', label: 'Tentang', href: '/about/' },
  { roman: 'II', label: 'Kebijakan Editorial', href: '/editorial-policy/' },
  { roman: 'III', label: 'Kebijakan Sumber', href: '/source-policy/' },
  { roman: 'IV', label: 'Kebijakan AI', href: '/ai-policy/' },
  { roman: 'V', label: 'Koreksi', href: '/correction-policy/' },
  { roman: 'VI', label: 'Kontak', href: '/contact/' },
];
---

<footer>
  <div class="wrap">
    <div class="flinks">
      {
        footerLinks.map((link, index) => (
          <a href={link.href}>
            {link.roman}. {link.label}
            {index < footerLinks.length - 1 ? ',' : ''}
          </a>
        ))
      }
    </div>
    <div class="big" aria-hidden="true">SEMBURAT</div>
    <div class="fbottom small">
      <span>© {year} SEMBURAT. Hak cipta dilindungi.</span>
      <span><a href="/privacy/">Privasi</a>, <a href="/terms/">Ketentuan</a></span>
    </div>
  </div>
</footer>
