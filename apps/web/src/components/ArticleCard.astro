---
interface Props {
  title: string;
  dek: string;
  category: string;
  categoryHref?: string;
  date: string;
  readTime: string;
  slug: string;
}

const {
  title,
  dek,
  category,
  categoryHref = '/categories/berita',
  date,
  readTime,
  slug,
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<article class='flex h-full flex-col rounded-lg border border-sb-hairline bg-sb-card p-5 transition-all hover:border-sb-border-subtle hover:shadow-ambient'>
  <div class='mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-sb-muted tracking-wide'>
    <a href={categoryHref} class='rounded-full bg-sb-primary/10 px-2.5 py-0.5 font-label font-semibold text-sb-primary uppercase tracking-wider'>
      {category}
    </a>
    <time datetime={date}>{formattedDate}</time>
    <span aria-hidden='true'>·</span>
    <span>{readTime} menit baca</span>
  </div>
  <h3 class='mb-2 font-heading text-lg font-normal leading-snug text-sb-ink'>
    <a href={'/articles/' + slug} class='transition-colors hover:text-sb-primary'>
      {title}
    </a>
  </h3>
  <p class='mb-4 font-body text-sm leading-relaxed text-sb-muted'>{dek}</p>
  <a href={'/articles/' + slug} class='mt-auto inline-flex items-center font-body text-sm font-medium text-sb-primary hover:text-sb-primary-surface'>
    Baca selengkapnya<span aria-hidden='true'> →</span>
  </a>
</article>
