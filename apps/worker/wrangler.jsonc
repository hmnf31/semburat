{
  "name": "semburat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semburat-db",
      "database_id": "@cf/db-id",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
  },
  "env": {
    "production": {
      "name": "semburat-worker-production",
      "vars": {
        "ENVIRONMENT": "production",
      },
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "semburat-assets",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "semburat-db",
          "database_id": "@cf/db-id-prod",
          "migrations_dir": "../../packages/db/src/migrations",
        },
      ],
    },
    "staging": {
      "name": "semburat-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "semburat-db-staging",
          "database_id": "91bf4878-cd19-4eb4-9fe0-a46e9326de20",
          "migrations_dir": "../../packages/db/src/migrations",
        },
      ],
    },
  },
}
