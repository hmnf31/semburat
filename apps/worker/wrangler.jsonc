{
  "name": "semburat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semburat-db",
      "database_id": "@cf/db-id",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "TREND_QUERIES": "MLBB MPL,gta 6,viral indonesia,teknologi indonesia",
    "REDDIT_SUBREDDITS": "indonesia,gaming,GTA6,MobileLegendsGame,technology",
    "ENABLE_FANART": "true",
  },
  "env": {
    "production": {
      "name": "semburat-worker-production",
      "vars": {
        "ENVIRONMENT": "production",
        "TREND_QUERIES": "MLBB MPL,gta 6,viral indonesia,teknologi indonesia",
        "REDDIT_SUBREDDITS": "indonesia,gaming,GTA6,MobileLegendsGame,technology",
        "ENABLE_FANART": "true",
        "AI_PROVIDER": "groq",
        "AI_BASE_URL": "https://api.groq.com/openai/v1",
        "AI_MODEL": "openai/gpt-oss-120b",
        "ASSETS_PUBLIC_BASE_URL": "https://semburat-worker-production.theahuda.workers.dev/media",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "semburat-db",
          "database_id": "0314425f-0ef4-48e0-9ed3-01b8e880093a",
          "migrations_dir": "../../packages/db/src/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "ASSETS",
          "id": "0af6ab72b8bd42fcbed906c0e48aecd3",
        },
      ],
    },
    "staging": {
      "name": "semburat-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "TREND_QUERIES": "MLBB MPL,gta 6,viral indonesia,teknologi indonesia",
        "REDDIT_SUBREDDITS": "indonesia,gaming,GTA6,MobileLegendsGame,technology",
        "ENABLE_FANART": "true",
        "AI_PROVIDER": "groq",
        "AI_BASE_URL": "https://api.groq.com/openai/v1",
        "AI_MODEL": "openai/gpt-oss-120b",
        "ASSETS_PUBLIC_BASE_URL": "https://semburat-worker-staging.theahuda.workers.dev/media",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "semburat-db-staging",
          "database_id": "91bf4878-cd19-4eb4-9fe0-a46e9326de20",
          "migrations_dir": "../../packages/db/src/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "ASSETS",
          "id": "da70ff64739b4474b1ee49e62d4a7975",
        },
      ],
    },
  },
}
