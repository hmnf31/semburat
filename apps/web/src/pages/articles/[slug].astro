---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SourceAttribution from '../../components/SourceAttribution.astro';
import CreditVisual from '../../components/CreditVisual.astro';
import heroImage from '../../assets/hero-placeholder.svg';
import type { ContentArticle } from '../../lib/content';
import { getArticles, getRelated } from '../../lib/content';
import { DEFAULT_OG_IMAGE, SITE_URL } from '../../lib/site';

function wordsPerMinute(text: string): number {
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
}

function formatWib(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return iso;
  const parts = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Jakarta',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).formatToParts(date);
  const day = parts.find((p) => p.type === 'day')?.value;
  const month = parts.find((p) => p.type === 'month')?.value;
  const year = parts.find((p) => p.type === 'year')?.value;
  const hour = parts.find((p) => p.type === 'hour')?.value;
  const minute = parts.find((p) => p.type === 'minute')?.value;
  return `${day} ${month} ${year}, ${hour}:${minute} WIB`;
}

function riskLevelClass(level: ContentArticle['riskLevel']): string {
  switch (level) {
    case 'LOW': return 'bg-sb-success/10 text-sb-success border-sb-success/30';
    case 'MEDIUM': return 'bg-sb-warning/10 text-sb-warning border-sb-warning/30';
    case 'HIGH': return 'bg-sb-error/10 text-sb-error border-sb-error/30';
  }
}

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: ContentArticle };
const readTime = wordsPerMinute(article.body);
const categoryHref = `/categories/${article.category.toLowerCase()}`;
const canonicalUrl = `${SITE_URL}/articles/${article.slug}`;
const ogImage = DEFAULT_OG_IMAGE;
const publishedWib = formatWib(article.publishedAt);

const isUpdated =
  article.updatedAt !== undefined &&
  new Date(article.updatedAt).getTime() - new Date(article.publishedAt).getTime() > 60 * 60 * 1000;
const updatedWib = isUpdated && article.updatedAt ? formatWib(article.updatedAt) : null;

const related = await getRelated(article.slug);

const breadcrumbItems = [
  { name: 'Beranda', href: '/' },
  { name: article.category, href: categoryHref },
  { name: article.title },
];
---
<ArticleLayout
  title={article.title}
  description={article.dek}
image={ogImage}
  publishedTime={article.publishedAt}
  modifiedTime={article.updatedAt ?? article.publishedAt}
  canonicalUrl={canonicalUrl}
  breadcrumbItems={breadcrumbItems}
  section={article.category}
>
  <header class="mb-8">
    <nav class="mb-4 text-sm text-sb-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-sb-primary">Beranda</a>
      <span aria-hidden="true"> / </span>
      <a href={categoryHref} class="hover:text-sb-primary">{article.category}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">Artikel</span>
    </nav>
    <a href={categoryHref} class="mb-3 inline-block rounded-full bg-sb-primary/10 px-2.5 py-0.5 font-label text-xs font-semibold text-sb-primary uppercase tracking-wider">
      {article.category}
    </a>
    <h1 class="font-heading text-3xl font-normal leading-tight text-sb-ink sm:text-4xl">
      {article.title}
    </h1>
    <p class="mt-4 font-body text-lg leading-relaxed text-sb-muted">
      {article.dek}
    </p>
<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-sb-muted">
      <time datetime={article.publishedAt}>{publishedWib}</time>
      <span aria-hidden="true">·</span>
      <span>{readTime} menit baca</span>
      {updatedWib && (
        <>
          <span aria-hidden="true">·</span>
          <span>Diperbarui {updatedWib}</span>
        </>
      )}
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2">
      <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 font-label text-xs font-semibold ${riskLevelClass(article.riskLevel)}`}>
        Risiko: {article.riskLevel}
      </span>
      <span class="inline-flex items-center rounded-full border bg-sb-primary/10 px-2.5 py-0.5 font-label text-xs font-semibold text-sb-primary border-sb-primary/30">
        Kualitas: {article.qualityScore}/100
      </span>
    </div>
  </header>
  <img src={heroImage} alt={`Visual placeholder untuk ${article.title}`} width="1200" height="630" class="mb-8 w-full rounded-lg border border-sb-hairline" />
  <div class="space-y-4 mb-8">
    {article.body.split('\n\n').filter(Boolean).map((paragraph) => (
      <p class="font-body leading-relaxed text-sb-ink" set:html={paragraph} />
    ))}
  </div>
  {article.keyPoints.length > 0 && (
    <section class="mb-8 p-6 rounded-lg bg-sb-primary/5 border border-sb-primary/20" aria-labelledby="key-points-heading">
      <h2 id="key-points-heading" class="mb-4 font-heading text-lg font-semibold text-sb-ink">
        Poin Penting
      </h2>
      <ul class="space-y-2 font-body text-sb-ink">
        {article.keyPoints.map((point, i) => (
          <li class="flex gap-2" key={i}>
            <span class="flex-shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-sb-primary" aria-hidden="true" />
            <span set:html={point} />
          </li>
        ))}
      </ul>
    </section>
  )}
  {article.faq.length > 0 && (
    <section class="mb-8" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="mb-4 font-heading text-xl font-normal text-sb-ink">
        Pertanyaan Umum
      </h2>
      <dl class="space-y-6">
        {article.faq.map((item, i) => (
          <div class="border-t border-sb-hairline pt-4" key={i}>
            <dt class="font-heading font-semibold text-sb-ink" set:html={item.question} />
            <dd class="mt-2 font-body text-sb-ink" set:html={item.answer} />
          </div>
        ))}
      </dl>
    </section>
  )}
  {article.sources.length === 0 && (
    <p class="mt-10 rounded-lg border border-sb-hairline bg-sb-card p-5 font-body text-sm text-sb-muted">
      Tautan sumber terperinci belum tersedia untuk artikel ini. Proses verifikasi dan atribusi sumber tetap
      tercatat di pipeline editorial.
    </p>
  )}
  <SourceAttribution sources={article.sources} />
  <CreditVisual
    creator={article.assets[0]?.credit ?? 'Kreator tidak diketahui'}
    license={article.assets[0]?.license ?? 'Lisensi tidak diketahui'}
    credit={article.assets[0]?.credit ?? ''}
    sourceUrl={article.assets[0]?.sourceUrl}
  />
  {related.length > 0 && (
    <section class="mt-12" aria-labelledby="terkait-heading">
      <h2 id="terkait-heading" class="mb-6 font-heading text-xl font-normal text-sb-ink">
        Artikel Terkait
      </h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {related.map((relatedArticle) => (
          <ArticleCard {...relatedArticle} />
        ))}
      </div>
    </section>
  )}
</ArticleLayout>
