---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { softLaunchArticles } from '../data/soft-launch-articles';

function computeReadTime(body: string): string {
  const wordCount = body.split(/\\s+/).length;
  return String(Math.max(1, Math.ceil(wordCount / 200)));
}

const latestArticles = softLaunchArticles
  .filter((a) => a.status === 'published')
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 6)
  .map((article) => ({
    title: article.title,
    dek: article.dek,
    category: article.category,
    categoryHref: '/categories/' + article.category.toLowerCase(),
    date: article.publishedAt,
    readTime: computeReadTime(article.body),
    slug: article.slug,
  }));

const trendingTopics = softLaunchArticles
  .filter((a) => a.status === 'published')
  .reduce((acc, article) => {
    const key = article.category;
    acc[key] = (acc[key] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);

const trendingTopicsArray = Object.entries(trendingTopics)
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);
---

<BaseLayout title="Beranda" description="SEMBURAT — platform media intelligence Indonesia. Yang sedang muncul, kami rangkai menjadi cerita.">
  <section class="bg-primary px-4 py-16 text-center sm:py-20">
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">Media Intelligence Indonesia</p>
    <h1 class="mx-auto max-w-2xl text-3xl font-bold leading-tight text-white sm:text-4xl">
      Yang sedang muncul, kami rangkai menjadi cerita.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-slate-300">
      SEMBURAT merangkum tren, sumber, dan konteks menjadi artikel editorial yang terverifikasi dan transparan.
    </p>
  </section>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-primary">Artikel Terbaru</h2>
        <p class="mt-1 text-sm text-text-muted">10 artikel contoh untuk soft launch.</p>
      </div>
      <a href="/trending" class="text-sm font-medium text-accent hover:text-accent-hover">
        Lihat trending →
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestArticles.map((article) => (
        <ArticleCard {...article} />
      ))}
    </div>
  </section>
  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="mb-6 text-2xl font-bold text-primary">Topik Trending</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {trendingTopicsArray.map((topic, index) => (
          <li class="rounded-lg border border-border bg-background p-4">
            <span class="mb-2 block text-2xl font-bold text-accent">{index + 1}</span>
            <a href="/trending" class="font-medium text-primary hover:underline">
              {topic.label}
            </a>
            <p class="mt-1 text-xs text-text-muted">{topic.count} artikel</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>