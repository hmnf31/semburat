# SEMBURAT environment template
# Never commit real secrets.
#
# Classification:
#   [PUBLIC]     Safe to expose to the browser / client bundles.
#   [SERVER]     Must never leave the server environment.

# Runtime
# [PUBLIC] Node.js runtime environment
NODE_ENV=development

# Cloudflare
# [SERVER] Cloudflare account ID for Workers, D1, R2
CLOUDFLARE_ACCOUNT_ID=
# [SERVER] Cloudflare API token with scoped permissions
CLOUDFLARE_API_TOKEN=
# [SERVER] UUID of the D1 database
D1_DATABASE_ID=
# [SERVER] Name of the R2 storage bucket
R2_BUCKET=
# [SERVER] Public base URL for signed R2 asset links
R2_PUBLIC_BASE_URL=

# AI
# [SERVER] API key for OpenRouter (primary AI provider)
OPENROUTER_API_KEY=
# [SERVER] Default model identifier for OpenRouter
OPENROUTER_MODEL=
# [SERVER] Default model identifier for OpenRouter (legacy alias)
OPENROUTER_DEFAULT_MODEL=
# Optional local AI
# [SERVER] Base URL for optional local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
# [SERVER] Default local Ollama model
OLLAMA_DEFAULT_MODEL=

# Research sources
# [SERVER] live = fetch real sources (Google News RSS); offline = never touch the network
RESEARCH_MODE=live
# [SERVER] Extra RSS feed URLs, comma separated (empty = built-in Google News headlines)
RSS_FEEDS=
# [SERVER] Seed trend queries, comma separated
TREND_QUERIES=gaming indonesia,teknologi indonesia

# Telegram
# [SERVER] Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# [SERVER] Secret used to validate webhook requests
TELEGRAM_WEBHOOK_SECRET=
# [SERVER] Comma separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# MiniMax
# [SERVER] API key for MiniMax voice/SFX generation
MINIMAX_API_KEY=
# [SERVER] Default MiniMax model identifier
MINIMAX_MODEL=

# Google Sheets
# [SERVER] Service-account credentials JSON (full secret)
GOOGLE_SHEETS_CREDENTIALS_JSON=
# [SERVER] ID of the operational spreadsheet
GOOGLE_SHEETS_SPREADSHEET_ID=

# Application
# [SERVER] Base URL of the application backend
APP_BASE_URL=
# [PUBLIC] Public website URL (may be exposed to clients)
PUBLIC_SITE_URL=

# Observability
# [SERVER] Logging verbosity (debug, info, warn, error)
LOG_LEVEL=info

# Social & publishing
# [SERVER] Platform API keys until platform permissions exist
SOCIAL_API_KEYS=
# [SERVER] true = do not publish anything (dry run)
SEMBURAT_DRY_RUN=true
# [SERVER] Keep false during soft launch
SEMBURAT_AUTO_PUBLISH=false
# [SERVER] true = stop every scheduled job
SEMBURAT_KILL_SWITCH=false
# [SERVER] Public site domain
SITE_URL=https://GANTI-DENGAN-DOMAIN-ANDA