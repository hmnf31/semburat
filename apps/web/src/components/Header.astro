---
interface Props {
  big?: boolean;
  active?: string;
}

const { big = false, active = '' } = Astro.props;

const navItems = [
  { key: 'beranda', roman: 'I', label: 'Beranda', href: '/' },
  { key: 'trending', roman: 'II', label: 'Trending', href: '/trending/' },
  { key: 'categories', roman: 'III', label: 'Kategori', href: '/categories/' },
  { key: 'about', roman: 'IV', label: 'About', href: '/about/' },
];

const today = new Date().toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<header class="wrap">
  <div class="strip"><span>{today}</span><span>Media intelligence Indonesia</span></div>
  <div class="sweep" aria-hidden="true"></div>
  <a class={big ? 'mast' : 'mast sm'} href="/" aria-label="SEMBURAT, ke beranda">SEMBURAT</a>
  <button class="nav-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
  <nav class="idx" id="nav" aria-label="Utama">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
          {item.roman}. {item.label}
        </a>
      ))
    }
  </nav>
</header>
