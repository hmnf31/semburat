---
import PolicyLayout from '../layouts/PolicyLayout.astro';
import { siteConfig } from '../data/site-config';

const email = siteConfig.emails.editorial;
const rows = [
  'Redaksi umum',
  'Koreksi fakta',
  'Hak cipta / permintaan penurunan konten',
  'Kerja sama & sponsor',
  'Privasi data',
];
---

<PolicyLayout
  title="Kontak"
  kicker="Halaman"
  description="Hubungi redaksi SEMBURAT."
  activeSlug="contact"
>
  <div class="contact-card">
    <p class="small" style="margin:0">
      Untuk keperluan editorial, koreksi, atau kerja sama, kirim email ke
    </p>
    <a class="em" href={`mailto:${email}`}>{email}</a>
    <a class="btn" href={`mailto:${email}`}>Kirim email</a>
  </div>
  <table class="tbl">
    <thead>
      <tr><th>Keperluan</th><th>Email</th></tr>
    </thead>
    <tbody>
      {
        rows.map((label) => (
          <tr>
            <td>{label}</td>
            <td>
              <a href={`mailto:${email}`}>{email}</a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p>Kami berupaya membalas dalam {siteConfig.responseBusinessDays} hari kerja.</p>
</PolicyLayout>
